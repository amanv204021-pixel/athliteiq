# Copy to .env and fill in for production
# Leave blank for a random per-start development key. Set a private value for production.
SECRET_KEY=
DATABASE_URL=sqlite:///./sports_talent.db
# DATABASE_URL=postgresql://user:pass@localhost/sportsdb
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=80
MAX_FRAMES=900
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
